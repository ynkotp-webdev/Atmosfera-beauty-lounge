---
import '../styles/global.css';
import displayCyr from '@fontsource/tenor-sans/files/tenor-sans-cyrillic-400-normal.woff2?url';
import Wordmark from '../components/Wordmark.astro';
import { salon, places, to } from '../data/salon';
import { getImage } from 'astro:assets';
import hall from '../assets/photos/hair-zone.jpg';

interface Props { title: string; description: string; home?: boolean; fab?: boolean }
const { title, description, home = false, fab = true } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// Прев'ю посилання в Telegram, Viber, Instagram: зал Шевченка, обрізаний до 1200×630. Месенджерам потрібна абсолютна адреса
const og = await getImage({ src: hall, width: 1200, height: 630, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site).href;
const nav = [
  { href: to('/tsiny'), label: 'Ціни' },
  { href: to('/komanda'), label: 'Майстри' },
  { href: to('/#adresy'), label: 'Адреси' },
];
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8e2d9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Atmosfera Beauty Lounge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Зал салону Атмосфера: темно-зелена стіна, пудрові крісла, арочні дзеркала" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={to('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={displayCyr} crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">До змісту</a>
    <header class:list={['hd small', { home }]}>
      <a class="brand" href={to('/')}><Wordmark part="main" label="Atmosfera Beauty Lounge, головна" /></a>
      {home && <span class="where">Львів · Шевченка, 17 · Залізнична, 9</span>}
      <nav aria-label="Основна навігація">
        {nav.map((n) => <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      {!home && <a class="sphere book" href={salon.booking} target="_blank" rel="noopener">Запис</a>}
    </header>

    <main id="main">
      <slot />

      <!-- Фінал кожної сторінки: контакти на звороті «візитки» -->
      <footer class="end wrap" id="kontakty">
        <div class="card back">
          <div class="sign">
            <div class="mark"><Wordmark part="full" gold view /></div>
            <a class="sphere" href={salon.booking} target="_blank" rel="noopener">Записатися</a>
          </div>
          {places.map((pl) => (
            <section class="place">
              <h2 class="disp h3">{pl.short}</h2>
              <p class="mute small">{pl.name}</p>
              <address>Львів, {pl.address}</address>
              <ul>
                <li><a class="under tap num" href={pl.phone.href}>{pl.phone.text}</a></li>
                <li><a class="under tap" href={pl.route} target="_blank" rel="noopener">Маршрут</a></li>
                <li><a class="under tap" href={pl.booking} target="_blank" rel="noopener">Запис {pl.to}</a></li>
              </ul>
            </section>
          ))}
          <section class="common">
            <dl class="hours">
              {salon.hours.map((h) => (<><dt class="mute">{h.days}</dt><dd class="num">{h.time}</dd></>))}
            </dl>
            <p class="mute small">Обидві адреси працюють однаково.</p>
            <ul>
              <li><a class="under tap" href={salon.instagram} target="_blank" rel="noopener">Instagram @atmosfera_lv</a></li>
              <li><a class="under tap" href={salon.direct} target="_blank" rel="noopener">Написати в Direct</a></li>
            </ul>
          </section>
          <p class="note label mute">Концепт сайту від YonkaAgency, зроблений без замовлення салону. Фото й тексти належать салону «Атмосфера», його клієнткам і авторам знімків. Актуальні ціни й розклад дивись в онлайн-записі.</p>
        </div>
      </footer>

      <!-- Куля запису на телефоні. Зона починається через один екран, тому на першому екрані її немає. Без JS -->
      {fab && (
        <div class="fabzone">
          <a class="sphere fab" href={salon.booking} target="_blank" rel="noopener">Запис</a>
        </div>
      )}
    </main>

    <script>
      // М'який курсор: крапка точно під мишею, пудрова куля м'яко її наздоганяє (кулі-світильники й кругле дзеркало
      // в залі). На посиланнях куля більшає, над кільцем «Роботи» стає кулею з написом «тягни». Тільки миша
      const root = document.documentElement;
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const dot = document.createElement('div'), ball = document.createElement('div');
        dot.className = 'cur-dot'; ball.className = 'cur-ball';
        ball.innerHTML = '<span>тягни</span>';
        dot.setAttribute('aria-hidden', 'true'); ball.setAttribute('aria-hidden', 'true');
        document.body.append(ball, dot);
        root.classList.add('cur', 'cur-off');
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let x = 0, y = 0, bx = 0, by = 0, raf = 0, last: Element | null = null;
        // Поверхня під мишею: перший предок із заливкою. Темна, пудрова (червоний канал більший) або м'ятна
        const surface = (el: Element | null) => {
          for (let e = el; e && e !== root; e = e.parentElement) {
            const [r, g, b, a = 1] = (getComputedStyle(e).backgroundColor.match(/[\d.]+/g) ?? []).map(Number);
            if (r === undefined || a < 0.5) continue;
            return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.4 ? 'dark' : r > g ? 'rose' : 'mint';
          }
          return 'mint';
        };
        const look = (t: Element | null) => {
          if (!t || t === last) return;
          last = t;
          const mode = t.closest('.orbit.on') ? 'drag' : t.closest('a, button, summary, label') ? 'link' : '';
          if ((root.dataset.cur ?? '') !== mode) root.dataset.cur = mode;
          const on = surface(t);
          if (root.dataset.on !== on) root.dataset.on = on;
        };
        const follow = () => {
          bx += (x - bx) * 0.18; by += (y - by) * 0.18;
          ball.style.transform = `translate(${bx.toFixed(1)}px, ${by.toFixed(1)}px)`;
          raf = Math.abs(x - bx) + Math.abs(y - by) > 0.2 ? requestAnimationFrame(follow) : 0;
        };
        addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          x = e.clientX; y = e.clientY;
          if (root.classList.contains('cur-off')) { bx = x; by = y; root.classList.remove('cur-off'); }
          dot.style.transform = `translate(${x}px, ${y}px)`;
          if (still) { bx = x; by = y; ball.style.transform = dot.style.transform; } else if (!raf) raf = requestAnimationFrame(follow);
          look(e.target as Element);
        }, { passive: true });
        // Сторінка їде під нерухомою мишею: поверхня під кулею теж змінюється
        addEventListener('scroll', () => { if (!root.classList.contains('cur-off')) look(document.elementFromPoint(x, y)); }, { passive: true });
        root.addEventListener('mouseleave', () => root.classList.add('cur-off'));
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--gut); top: -4rem; z-index: 50; padding: 0.75rem 1rem; background: var(--color-wall); color: var(--color-mint); }
  .skip:focus { top: 0.5rem; }

  /* Шапка їде разом зі сторінкою: ціни й майстри завжди під рукою. Висота = --hd, від неї рахуються інші липкі блоки */
  .hd { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.25rem); min-height: var(--hd); padding-inline: var(--gut); position: sticky; top: 0; z-index: 30; background: var(--color-mint); }
  /* На головній шапка лежить поверх першого екрана, не зсуваючи його */
  .hd.home { min-height: 4rem; margin-bottom: -4rem; justify-content: space-between; }
  .hd.home .brand { display: none; }
  .brand { display: inline-flex; align-items: center; min-height: 2.75rem; width: 9.5rem; margin-right: auto; }
  .hd nav { display: flex; gap: clamp(0.5rem, 2vw, 2rem); }
  .hd nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; min-width: 2.75rem; text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 0.45em; transition: text-decoration-color 0.2s; }
  .hd nav a:hover, .hd nav a[aria-current] { text-decoration-color: currentColor; }
  .book { --sphere: 3.75rem; --sphere-bg: var(--color-wall); --sphere-fg: var(--color-mint); font-size: var(--t-label); }
  @media (max-width: 720px) {
    .hd, .hd.home { min-height: var(--hd); }
    .hd.home { margin-bottom: calc(var(--hd) * -1); }
    .where, .book { display: none; }
    .hd.home nav { margin-left: auto; }
    .brand { width: 7.5rem; }
    /* Головна на телефоні: знак у шапці проявляється, коли великий ATMO першого екрана поїхав угору */
    @supports (animation-timeline: scroll()) {
      .hd.home .brand { display: inline-flex; animation: brand-in linear both; animation-timeline: scroll(root); animation-range: 35vh 60vh; }
    }
  }
  @keyframes brand-in { from { opacity: 0; visibility: hidden; } to { opacity: 1; visibility: visible; } }

  main { position: relative; }
  .fabzone { display: none; }
  @media (max-width: 720px) {
    .fabzone { display: block; position: absolute; inset: 100svh 0 0; z-index: 20; pointer-events: none; }
    .fab { position: sticky; top: calc(100dvh - 5.75rem - env(safe-area-inset-bottom)); margin: 0 var(--gut) 0 auto; pointer-events: auto; --sphere: 4.75rem; font-size: var(--t-small); box-shadow: 0 0 0 4px var(--color-mint); /* суцільне кільце кольору столу: кулю видно і на пудрі, і на темній картці */ }
  }

  /* Зворот візитки: темна картка лежить на м'яті, не на всю ширину */
  .end { padding-block: var(--block) var(--gut); }
  .back { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 2.5rem; padding-block: clamp(2rem, 4vw, 3.5rem); }
  .sign { grid-column: 1 / span 4; display: grid; align-content: space-between; justify-items: start; gap: 2rem; }
  .mark { width: min(15rem, 100%); }
  .sign .sphere { --sphere: 8rem; }
  .place { grid-column: span 3; }
  .common { grid-column: span 2; }
  .place address { margin-top: 0.75rem; }
  .place ul, .common ul { margin-top: 0.25rem; display: grid; justify-items: start; }
  .hours { display: grid; font-size: var(--t-lead); line-height: 1.3; }
  .hours dt { font-size: var(--t-small); }
  .hours dd + dt { margin-top: 0.5rem; }
  .common p { margin-top: 0.4rem; }
  .note { grid-column: 5 / -1; max-width: 62ch; }
  @media (max-width: 1100px) {
    .sign { grid-column: 1 / -1; grid-template-columns: 1fr auto; align-items: center; }
    .place, .common { grid-column: span 4; }
    .note { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .end { padding-bottom: 0; padding-inline: 0; }
    .back { padding-inline: var(--gut); padding-bottom: 7rem; }
    .place, .common { grid-column: 1 / -1; }
    .sign { gap: 1rem; }
    .mark { width: min(11rem, 50vw); }
    .sign .sphere { --sphere: 6.25rem; font-size: var(--t-small); }
  }
</style>
